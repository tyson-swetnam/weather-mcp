{
  "name": "weather-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for National Weather Service API with fire weather monitoring",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "build:dev": "tsc --watch",
    "watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "weather",
    "nws",
    "fire-weather",
    "red-flag-warning",
    "forecast",
    "api",
    "national-weather-service"
  ],
  "author": "Tyson Swetnam",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tyson-swetnam/weather-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "node-cache": "^5.1.2",
    "p-queue": "^8.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}