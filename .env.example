# National Weather Service API Configuration
# No API key required, but User-Agent header is mandatory

# Custom User-Agent (defaults to weather-mcp/1.0.0)
# Format: YourApp/Version (contact.email@example.com)
NWS_USER_AGENT=weather-mcp/1.0.0 (your.email@example.com)

# Rate limiting (requests per second, default: 5)
NWS_RATE_LIMIT=5

# Cache TTL settings (in seconds)
CACHE_TTL_ALERTS=300       # 5 minutes for critical alerts
CACHE_TTL_FORECAST=3600    # 1 hour for forecasts
CACHE_TTL_GRID_DATA=1800   # 30 minutes for grid data
CACHE_TTL_STATIONS=86400   # 24 hours for station metadata
CACHE_TTL_FIRE_ZONES=43200 # 12 hours for fire zone data

# Enable/disable caching (default: true)
CACHE_ENABLED=true

# MCP Server Configuration
MCP_SERVER_NAME=weather-mcp
MCP_SERVER_VERSION=1.0.0

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Server port (for standalone mode)
SERVER_PORT=3000

# Enable debug mode for development
DEBUG=false